{
  "name": "shengsheng",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "headless": "tsx tools/headless/src/cli.ts",
    "dev": "pnpm --filter @ss/web dev",
    "build": "pnpm --filter @ss/web build",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm headless --scenario replay && pnpm build",
    "e2e": "node tools/e2e/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "3.2.4"
  }
}
